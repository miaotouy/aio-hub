{
  "name": "aiohub",
  "private": true,
  "version": "0.7.0-alpha.1",
  "packageManager": "bun@1.3.11",
  "type": "module",
  "license": "Apache-2.0",
  "author": "miaotouy",
  "description": "一个基于 Tauri + Vue 3 开发的桌面端枢纽应用，提供多种实用的开发和日常工具",
  "repository": {
    "type": "git",
    "url": "https://github.com/miaotouy/aio-hub"
  },
  "bugs": {
    "url": "https://github.com/miaotouy/aio-hub/issues"
  },
  "homepage": "https://github.com/miaotouy/aio-hub#readme",
  "funding": {
    "type": "individual",
    "url": "https://afdian.com/a/miaotouy"
  },
  "workspaces": [
    "packages/*",
    "plugins/*",
    "mobile"
  ],
  "scripts": {
    "preinstall": "bun scripts/security/scan-dependencies.ts --mode lock",
    "postinstall": "bun scripts/security/scan-dependencies.ts --mode installed && bun run scripts/setup-wry-patch.ts",
    "generate:shims": "bun scripts/generate-shims.ts",
    "release:updater-manifest": "bun scripts/generate-updater-manifest.ts",
    "version:set": "bun scripts/version.ts set",
    "version:check": "bun scripts/version.ts check",
    "dev": "bun run generate:shims && bun scripts/dev.ts",
    "vite": "vite",
    "download:libs": "bun scripts/download-libs.ts",
    "build": "bun run generate:shims && bun run download:libs && bun run check:release-notes && bun run build:tsc && bun run build:vite",
    "build:tsc": "vue-tsc --noEmit",
    "build:vite": "vite build",
    "build:mobile": "bun run --cwd mobile build",
    "preview": "vite preview",
    "check:model-icons": "bun scripts/check-model-icons.ts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "bun scripts/build.ts",
    "tauri:build:local": "bun scripts/build.ts --local",
    "test:build-app": "bun scripts/run-build-test.ts",
    "build:portable": "bun scripts/build-portable.ts",
    "build:portable:local": "bun scripts/build-portable.ts --local",
    "b:p": "bun scripts/build-portable.ts",
    "b:p:l": "bun scripts/build-portable.ts --local",
    "t:d": "tauri dev",
    "t:b": "bun scripts/build.ts",
    "b:l": "bun scripts/build.ts --local",
    "mtad": "bun run --cwd mobile tauri android dev",
    "mtab": "bun scripts/build-android.ts",
    "mtid": "bun run --cwd mobile tauri ios dev",
    "mtib": "bun run --cwd mobile tauri ios build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest --run",
    "test:tauri:e2e": "bun tests/tauri-e2e/run.ts",
    "test:tauri:e2e:unit": "vitest --config tests/tauri-e2e/vitest.config.ts --run",
    "test:tauri:e2e:native": "bun tests/tauri-e2e/run.ts --preset native",
    "test:mobile:e2e": "bun tests/mobile-android-e2e/run.ts",
    "test:mobile:e2e:unit": "vitest --config tests/mobile-android-e2e/vitest.config.ts --run",
    "test:mobile:e2e:typecheck": "tsc --noEmit -p tests/mobile-android-e2e/tsconfig.json",
    "test:mobile:e2e:smoke": "bun tests/mobile-android-e2e/run.ts --preset smoke",
    "test:mobile:e2e:asset": "bun tests/mobile-android-e2e/run.ts --preset asset",
    "test:mobile:e2e:attachment": "bun tests/mobile-android-e2e/run.ts --preset attachment",
    "test:mobile:e2e:recovery": "bun tests/mobile-android-e2e/run.ts --preset recovery",
    "test:mobile:e2e:ollama": "bun tests/mobile-android-e2e/run.ts --preset ollama",
    "test:backend": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:mobile": "bun run --cwd mobile test:run",
    "test:mobile:backend": "bun run --cwd mobile test:backend",
    "test:llm-core": "bun run --cwd packages/llm-core test:run",
    "test:all": "bun run test:run && bun run test:backend && bun run test:mobile && bun run test:mobile:backend && bun run test:llm-core",
    "test:coverage": "vitest --coverage",
    "lint": "oxlint .",
    "format": "prettier --write \"src/**/*.{ts,js,vue,json,css,scss}\" \"mobile/src/**/*.{ts,js,vue,json,css,scss}\" \"packages/**/*.{ts,js,vue,json,css,scss}\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,vue,json,css,scss}\" \"mobile/src/**/*.{ts,js,vue,json,css,scss}\" \"packages/**/*.{ts,js,vue,json,css,scss}\" \"docs/**/*.md\"",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml && cargo fmt --manifest-path mobile/src-tauri/Cargo.toml",
    "format:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo fmt --manifest-path mobile/src-tauri/Cargo.toml -- --check",
    "check": "bun run lint && bun run check:security && bun run check:model-icons && bun run check:release-notes && bun run check:frontend && bun run check:backend && bun run check:mobile && bun run check:packages",
    "check:ci": "bun run check:security && bun run check:release-notes && bun run check:frontend && bun run check:mobile:frontend && bun run check:backend:compile && bun run check:mobile:backend:compile && bun run test:backend",
    "check:full": "bun run format:check && bun run format:rust:check && bun run check && bun run test:all && bun run build:vite && bun run build:mobile && bun run docs:build",
    "check:frontend": "vue-tsc --noEmit",
    "check:backend": "bun run check:backend:lint",
    "check:backend:compile": "cargo check --manifest-path src-tauri/Cargo.toml",
    "check:backend:lint": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "check:mobile": "bun run --cwd mobile check",
    "check:mobile:frontend": "bun run --cwd mobile check:frontend",
    "check:mobile:backend": "bun run --cwd mobile check:backend",
    "check:mobile:backend:compile": "bun run --cwd mobile check:backend:compile",
    "check:mobile:backend:lint": "bun run --cwd mobile check:backend:lint",
    "check:packages": "bun run check:llm-core",
    "check:llm-core": "bun run --cwd packages/llm-core check",
    "license:add": "bun run scripts/add-license.ts",
    "license:check": "bun run scripts/add-license.ts --dry-run",
    "check:release-notes": "bun scripts/check-release-notes.ts",
    "security:dependencies": "bun scripts/security/scan-dependencies.ts --mode installed",
    "security:dependencies:strict": "bun scripts/security/scan-dependencies.ts --mode installed --fail-on medium",
    "security:audit": "bun audit --audit-level high",
    "check:security": "bun run security:dependencies"
  },
  "dependencies": {
    "@aiohub/llm-core": "workspace:*",
